# Android SDK location
ANDROID_HOME=$HOME/Library/Android/sdk

# TV (Chromecast with Google TV) IP on the local network
TV_HOST=192.168.10.210

# Release signing (keystore lives outside the repo)
KEYSTORE_FILE=$HOME/.keystores/googletvlauncher.jks
KEYSTORE_PASSWORD=
KEY_ALIAS=googletvlauncher
KEY_PASSWORD=

# Home screen
# Dock apps, left to right, comma-separated. Missing packages are skipped.
DOCK_PACKAGES=com.google.android.youtube.tv
# Extra apps never shown in the grid (Play Store and Settings are always hidden; they have their own pills)
HIDDEN_PACKAGES=
# Name of a drawable in res/drawable (e.g. "wallpaper" for wallpaper.jpg). Empty = pitch black.
WALLPAPER_DRAWABLE=

# Home Assistant. Leave HASS_URL or HASS_TOKEN empty to hide everything below.
HASS_URL=https://homeassistant.local:8123
# Profile → Security → Long-lived access tokens
HASS_TOKEN=
# Entity IDs; leave any empty to hide that part
HASS_WEATHER=weather.forecast_home
HASS_AQI=
HASS_INSIDE_TEMPERATURE=
HASS_INSIDE_HUMIDITY=
HASS_LIGHT=
HASS_CLIMATE=
# Target temperature range offered for HASS_CLIMATE
HASS_CLIMATE_MIN_TEMP=23
HASS_CLIMATE_MAX_TEMP=26
# Fan modes offered for HASS_CLIMATE, in order; "mode:Label" renames one. Empty = the modes the entity reports.
HASS_CLIMATE_FAN_MODES=auto,low,medium,high
