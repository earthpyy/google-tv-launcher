<?xml version="1.0" encoding="utf-8"?>
<!-- Ring around a "Who's watching" avatar; bright when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="#24FFFFFF" />
            <stroke android:width="4dp" android:color="#EBFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
