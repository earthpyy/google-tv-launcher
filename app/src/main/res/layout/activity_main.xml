<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- The outgoing wallpaper, held under the new one while it fades in -->
    <FrameLayout
        android:id="@+id/wallpaper_previous"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/wallpaper_previous_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/wallpaper_previous_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- A picture and its scrim fade as one, so the scrim never lags behind -->
    <FrameLayout
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/wallpaper_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/wallpaper_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Scrolls as a whole: home screen on top, app grid below it -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <View
            android:id="@+id/glow"
            android:layout_width="760dp"
            android:layout_height="460dp" />

        <LinearLayout
            android:id="@+id/clock_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="36dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="84sp" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="20sp" />

            <!-- Home Assistant glance: weather, AQI and indoor climate -->
            <TextView
                android:id="@+id/glance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />

            <!-- Favourite teams: next kick-off, live score or latest result -->
            <TextView
                android:id="@+id/football"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="64dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pill_light"
                style="@style/Pill"
                android:contentDescription="@string/pill_light"
                android:drawableStart="@drawable/ic_light"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pill_ac"
                style="@style/Pill"
                android:contentDescription="@string/pill_ac"
                android:drawableStart="@drawable/ic_ac"
                android:visibility="gone" />

            <!-- Wider gap between the home controls and the profile and system pills -->
            <ImageView
                android:id="@+id/pill_profile"
                style="@style/IconPill"
                android:layout_marginStart="32dp"
                android:contentDescription="@string/pill_profile"
                android:padding="2dp"
                android:src="@drawable/avatar_placeholder"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/pill_wallpaper"
                style="@style/IconPill"
                android:contentDescription="@string/pill_wallpaper"
                android:src="@drawable/ic_wallpaper" />

            <ImageView
                android:id="@+id/pill_store"
                style="@style/IconPill"
                android:contentDescription="@string/pill_store"
                android:src="@drawable/ic_store" />

            <ImageView
                android:id="@+id/pill_settings"
                style="@style/IconPill"
                android:contentDescription="@string/pill_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <View
            android:id="@+id/dock_band"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/dock_band" />

        <LinearLayout
            android:id="@+id/dock_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal" />

        <!-- Title and credit of a feed wallpaper, under the dock's right end; placed in code -->
        <TextView
            android:id="@+id/wallpaper_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- Below the grid while any app is hidden; opens the hidden apps grid under it -->
        <TextView
            android:id="@+id/hidden_toggle"
            style="@style/SmallPill"
            android:layout_gravity="top|center_horizontal"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hidden_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <!-- AC panel, placed under the AC pill when opened; the glass highlight marks its focused row -->
        <LinearLayout
            android:id="@+id/ac_panel"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/ac_power"
                style="@style/PanelRow">

                <TextView
                    android:id="@+id/ac_power_label"
                    style="@style/PanelLabel"
                    android:text="@string/panel_power" />

                <TextView
                    android:id="@+id/ac_power_value"
                    style="@style/PanelValue"
                    android:layout_marginEnd="24dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ac_temp"
                style="@style/PanelRow">

                <TextView
                    android:id="@+id/ac_temp_label"
                    style="@style/PanelLabel"
                    android:text="@string/panel_temperature" />

                <TextView
                    android:id="@+id/ac_temp_down"
                    style="@style/PanelArrow"
                    android:text="@string/arrow_left" />

                <TextView
                    android:id="@+id/ac_temp_value"
                    style="@style/PanelValue" />

                <TextView
                    android:id="@+id/ac_temp_up"
                    style="@style/PanelArrow"
                    android:text="@string/arrow_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ac_fan"
                style="@style/PanelRow">

                <TextView
                    android:id="@+id/ac_fan_label"
                    style="@style/PanelLabel"
                    android:text="@string/panel_fan" />

                <TextView
                    android:id="@+id/ac_fan_down"
                    style="@style/PanelArrow"
                    android:text="@string/arrow_left" />

                <TextView
                    android:id="@+id/ac_fan_value"
                    style="@style/PanelValue" />

                <TextView
                    android:id="@+id/ac_fan_up"
                    style="@style/PanelArrow"
                    android:text="@string/arrow_right" />
            </LinearLayout>
        </LinearLayout>

        <!-- Long-press menu of an app tile, placed next to it when opened -->
        <LinearLayout
            android:id="@+id/tile_menu"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_background"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="invisible" />

        <me.earthpyy.googletvlauncher.GlassView
            android:id="@+id/glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Wallpaper strip, in place of the dock while open; the wallpaper behind previews the focused choice -->
    <LinearLayout
        android:id="@+id/wallpaper_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="44dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/wallpaper_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/wallpaper_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/wallpaper_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Who's watching: replaces the home screen on cold start and after a long standby -->
    <FrameLayout
        android:id="@+id/picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:visibility="gone">

        <TextView
            android:id="@+id/picker_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="64dp"
            android:textColor="#B3FFFFFF"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/picker_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picker_title"
                android:textColor="#FFFFFFFF"
                android:textSize="44sp" />

            <LinearLayout
                android:id="@+id/picker_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
