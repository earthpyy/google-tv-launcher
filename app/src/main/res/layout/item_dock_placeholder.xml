<?xml version="1.0" encoding="utf-8"?>
<!-- Stands in for the dock while it's empty; never focused. The card is sized in code like a tile -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/dock_placeholder"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:text="@string/dock_plus"
            android:textColor="#59FFFFFF"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/dock_hint"
            android:textColor="#66FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
